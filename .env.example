# Only needed when running from a clone. MCP clients pass these in their own config.
# Your instance, with or without /api2
POPULI_BASE_URL=https://yourschool.populiweb.com
# Account & Settings > API > Keys. Use an sk_sandbox_ key against a sandbox instance while evaluating.
POPULI_API_KEY=
# Uncomment to enable populi_write (create, update, delete)
# POPULI_ALLOW_WRITES=true
